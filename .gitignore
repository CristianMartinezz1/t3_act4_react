# ===========================================
# .gitignore - t3_act4_react (Vite + React)
# ===========================================

# --- Dependencias (se reinstalan con npm install) ---
node_modules/

# --- Builds generados por Vite (se recrean con npm run build) ---
dist/
dist-ssr/
build/

# --- Variables de entorno (pueden contener claves privadas) ---
.env
.env.*
*.local
!.env.example

# --- Logs y reportes de depuración ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Caché de herramientas ---
.cache/
.vite/
.eslintcache
coverage/

# --- Configuración local del editor ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.sw?

# --- Archivos del sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini